{
  "name": "permission-deny",
  "match": "(?i)\\bdelete\\b|\\bdrop\\b",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user_message",
      "timeout_ms": 5000,
      "store_as": "msg"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 50,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Preparing to delete..."}],"usage":{"input_tokens":600,"output_tokens":30,"cache_read_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"permission_request","id":"p2","tool":"Bash","description":"Delete build artifacts","command":"rm -rf build/","risk_level":"high"}
    },
    {
      "type": "await_stdin",
      "expect": "permission_response",
      "timeout_ms": 30000,
      "store_as": "perm"
    },
    {
      "type": "emit",
      "delay_ms": 30,
      "on": {"perm.decision": "allow"},
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Operation completed."}],"usage":{"input_tokens":700,"output_tokens":35,"cache_read_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "on": {"perm.decision": "allow"},
      "event": {"type":"result","subtype":"success","total_cost_usd":0.008,"num_turns":2,"usage":{"input_tokens":1300,"output_tokens":65},"modelUsage":{"claude-sonnet-4-6":{"costUSD":0.008}}}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "on": {"perm.decision": "deny"},
      "event": {"type":"result","subtype":"error","total_cost_usd":0.004,"num_turns":1,"usage":{}}
    }
  ]
}
