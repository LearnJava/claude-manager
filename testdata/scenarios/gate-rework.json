{
  "name": "gate-rework",
  "match": "(?i)rework round \\d+ of \\d+",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 5000,
      "store_as": "msg"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Reworking after the gate report."}],"usage":{"input_tokens":1500,"output_tokens":60,"cache_read_input_tokens":1200}}}
    },
    {
      "type": "emit",
      "delay_ms": 50,
      "event": {"type":"result","subtype":"success","total_cost_usd":0.002,"num_turns":1,"usage":{"input_tokens":1500,"output_tokens":60},"modelUsage":{"claude-sonnet-4-6":{"costUSD":0.002}}}
    }
  ]
}
