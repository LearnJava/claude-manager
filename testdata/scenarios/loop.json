{
  "name": "loop",
  "match": "(?i)\\bloop\\b|\\brepeat\\b",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user_message",
      "timeout_ms": 5000,
      "store_as": "msg"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 50,
      "event": {"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"grep -r TODO . --include='*.go'"}}],"usage":{"input_tokens":800,"output_tokens":40,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 50,
      "event": {"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"grep -r TODO . --include='*.go'"}}],"usage":{"input_tokens":850,"output_tokens":40,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 50,
      "event": {"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"grep -r TODO . --include='*.go'"}}],"usage":{"input_tokens":900,"output_tokens":40,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 30,
      "event": {"type":"result","subtype":"success","total_cost_usd":0.004,"num_turns":3,"duration_ms":2500,"usage":{"input_tokens":2550,"output_tokens":120,"cache_read_input_tokens":0,"cache_creation_input_tokens":0},"modelUsage":{"claude-sonnet-4-6":{"inputTokens":2550,"outputTokens":120,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"costUSD":0.004,"contextWindow":200000,"maxOutputTokens":32000}}}
    }
  ]
}
