{
  "name": "rate-limit",
  "match": "(?i)\\brate.?limit\\b|\\bthrottle\\b",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 5000,
      "store_as": "msg"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 50,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Starting analysis..."}],"usage":{"input_tokens":1000,"output_tokens":50,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 10,
      "event": {"type":"rate_limit_event","rate_limit_info":{"status":"allowed_warning","resetsAt":1779584400,"rateLimitType":"seven_day","utilization":0.9,"isUsingOverage":false,"surpassedThreshold":0.75}}
    },
    {
      "type": "emit",
      "delay_ms": 200,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Resuming work after rate limit warning."}],"usage":{"input_tokens":1050,"output_tokens":60,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 30,
      "event": {"type":"result","subtype":"success","total_cost_usd":0.005,"num_turns":2,"duration_ms":3000,"usage":{"input_tokens":2050,"output_tokens":110,"cache_read_input_tokens":0,"cache_creation_input_tokens":0},"modelUsage":{"claude-sonnet-4-6":{"inputTokens":2050,"outputTokens":110,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"costUSD":0.005,"contextWindow":200000,"maxOutputTokens":32000}}}
    }
  ]
}
