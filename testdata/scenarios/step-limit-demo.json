{
  "name": "step-limit-demo",
  "match": "(?i)\\bstep-limit-demo\\b",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 5000,
      "store_as": "msg"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"result","subtype":"error_max_turns","result":"Stopped: reached the step limit","total_cost_usd":0.02,"num_turns":50}
    }
  ]
}
