{
  "name": "no-tasks-interactive",
  "match": "(?i)ad-hoc instruction",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 5000,
      "store_as": "msg"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 50,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Ready and waiting for instructions."}],"usage":{"input_tokens":300,"output_tokens":20,"cache_read_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 100,
      "event": {"type":"result","subtype":"success","total_cost_usd":0.001,"num_turns":1,"usage":{"input_tokens":300,"output_tokens":20},"modelUsage":{"claude-sonnet-4-6":{"costUSD":0.001}}}
    }
  ]
}
