{
  "name": "eval-failing",
  "match": "(?i)eval-failing",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 1,
  "steps": [
    {"type": "await_stdin", "expect": "user", "timeout_ms": 5000, "store_as": "msg"},
    {"type": "emit", "delay_ms": 0, "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}},
    {"type": "emit", "delay_ms": 10, "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Cannot continue: migration 0042 failed with duplicate key value violates unique constraint users_email_key."}],"usage":{"input_tokens":500,"output_tokens":30,"cache_read_input_tokens":0}}}},
    {"type": "emit", "delay_ms": 10, "event": {"type":"result","subtype":"error","result":"migration 0042 failed: duplicate key value violates unique constraint users_email_key","total_cost_usd":0.003,"num_turns":1,"usage":{"input_tokens":500,"output_tokens":30}}}
  ]
}
