{
  "name": "happy-path",
  "match": "(?i)\\bsimple\\b|\\bhappy\\b|\\bhello\\b",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user_message",
      "timeout_ms": 5000,
      "store_as": "msg"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 50,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Working on the task..."}],"usage":{"input_tokens":1200,"output_tokens":80,"cache_read_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 2500,
      "event": {"type":"result","subtype":"success","total_cost_usd":0.003,"num_turns":1,"usage":{"input_tokens":1200,"output_tokens":80},"modelUsage":{"claude-sonnet-4-6":{"costUSD":0.003}}}
    }
  ]
}
