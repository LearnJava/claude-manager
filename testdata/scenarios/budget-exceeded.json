{
  "name": "budget-exceeded",
  "match": "(?i)\\bbudget\\b|\\bover.?budget\\b",
  "model": "claude-opus-4-7",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 5000,
      "store_as": "msg"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash","Agent"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 50,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Executing large-scale refactor across the codebase..."}],"usage":{"input_tokens":120000,"cache_creation_input_tokens":80000,"cache_read_input_tokens":0,"output_tokens":3500}}}
    },
    {
      "type": "emit",
      "delay_ms": 30,
      "event": {"type":"result","subtype":"success","total_cost_usd":1.50,"num_turns":5,"duration_ms":45000,"usage":{"input_tokens":120000,"output_tokens":3500,"cache_read_input_tokens":0,"cache_creation_input_tokens":80000},"modelUsage":{"claude-opus-4-7":{"inputTokens":120000,"outputTokens":3500,"cacheReadInputTokens":0,"cacheCreationInputTokens":80000,"costUSD":1.50,"contextWindow":200000,"maxOutputTokens":32000}}}
    }
  ]
}
