{
  "name": "rate-limit-exceeded-demo",
  "match": "(?i)\\brate-limit-exceeded-demo\\b",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 5000,
      "store_as": "msg"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 10,
      "event": {"type":"rate_limit_event","rate_limit_info":{"status":"exceeded","resetsAt":1779584400,"rateLimitType":"seven_day","utilization":1.0,"isUsingOverage":false,"surpassedThreshold":1.0}}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"result","subtype":"success","total_cost_usd":0.001,"num_turns":1,"usage":{"input_tokens":10,"output_tokens":1}}
    }
  ]
}
