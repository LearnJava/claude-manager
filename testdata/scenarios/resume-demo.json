{
  "name": "resume-demo",
  "match": "(?i)\\bresume-demo\\b",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 5000,
      "store_as": "msg1"
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"first turn done"}],"usage":{"input_tokens":100,"output_tokens":10}}}
    },
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 15000,
      "store_as": "msg2"
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Got it, moving to step 2."}],"usage":{"input_tokens":150,"output_tokens":20}}}
    },
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 15000,
      "store_as": "msg3"
    }
  ]
}
