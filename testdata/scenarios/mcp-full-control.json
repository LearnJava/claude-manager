{
  "name": "mcp-full-control",
  "match": "(?i)\\bmcp-full-control\\b",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 5000,
      "store_as": "msg1"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Two ways to do it."}],"usage":{"input_tokens":900,"output_tokens":60,"cache_read_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"result","subtype":"success","result":"Two ways to do it.\n\n```ask-user\n{\"question\": \"Which way?\", \"options\": [\"Fast\", \"Safe\"]}\n```","total_cost_usd":0.01,"num_turns":1,"usage":{"input_tokens":900,"output_tokens":60},"modelUsage":{"claude-sonnet-4-6":{"costUSD":0.01}}}
    },
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 30000,
      "store_as": "answer"
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"permission_request","id":"p1","tool":"Edit","file_path":"src/main.go","description":"Edit source file","risk_level":"low"}
    },
    {
      "type": "await_stdin",
      "expect": "permission_response",
      "timeout_ms": 30000,
      "store_as": "perm"
    },
    {
      "type": "emit",
      "delay_ms": 30,
      "event": {"type":"assistant","message":{"content":[{"type":"text","text":"Done, the file is updated."}],"usage":{"input_tokens":950,"output_tokens":40,"cache_read_input_tokens":0}}}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"result","subtype":"success","result":"Done, the file is updated.","total_cost_usd":0.02,"num_turns":2,"usage":{"input_tokens":1850,"output_tokens":100},"modelUsage":{"claude-sonnet-4-6":{"costUSD":0.02}}}
    }
  ]
}
