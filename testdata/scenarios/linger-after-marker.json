{
  "name": "linger-after-marker",
  "match": "(?i)\\blinger-after-marker\\b",
  "model": "claude-sonnet-4-6",
  "context_window": 200000,
  "exit_code": 0,
  "steps": [
    {
      "type": "await_stdin",
      "expect": "user",
      "timeout_ms": 5000,
      "store_as": "msg"
    },
    {
      "type": "emit",
      "delay_ms": 0,
      "event": {"type":"system","subtype":"init","session_id":"${session_id}","model":"${model}","tools":["Read","Edit","Bash"],"cwd":"${cwd}"}
    },
    {
      "type": "emit",
      "delay_ms": 20,
      "event": {"type":"result","subtype":"success","result":"Done.\n\n```ask-user\n{\"question\": \"Start the next task?\", \"options\": [\"A\", \"B\"], \"kind\": \"continue_session\"}\n```","total_cost_usd":0.01,"num_turns":1}
    },
    {
      "type": "emit",
      "delay_ms": 20000,
      "event": {"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"still alive"}]},"session_id":"${session_id}"}
    }
  ]
}
