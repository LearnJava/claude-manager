# Build output (compiled binaries, generated scaffold) — the app icon
# assets are source, not output, so they stay tracked.
build/*
!build/appicon.png
!build/windows/
build/windows/*
!build/windows/icon.ico

# IDE
.idea/
.vscode/
*.swp
*.swo

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib

# Frontend
frontend/node_modules/
frontend/dist/

# Project mirror (internal/mirror): local copies of mirrored projects'
# settings and logs, kept in their own local-only git repository.
projects/

# Orchestrator runtime files
scripts/.taskstate.json
scripts/.taskstate.json.tmp
scripts/.stop
scripts/.jobstatus
scripts/.session.json
scripts/.session.json.tmp

# Wails
wailsjs/

# Python
scripts/__pycache__/

# Playwright
frontend/.playwright-state.json
frontend/playwright-report/
frontend/test-results/
testdata/configs/playwright-runtime.toml

# Worktree pool slots (scripts/worktree-pool.sh) — local checkouts, not sources
.claude/worktrees/
.tmp/

# GLM A/B benchmark (scripts/bench_glm.py): sandbox is re-seeded per run,
# runs/ holds transcripts + results.csv
benchmarks/glmlab/sandbox/
benchmarks/glmlab/runs/
__pycache__/
~$*
frontend/package.json.md5

# Local agent tool state: ZCode session plans, scratch test logs
.zcode/
frontend/.tmp-*.log
